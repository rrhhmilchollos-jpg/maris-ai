{
  "outputDirectory": "artifacts/appforge/dist",
  "buildCommand": "pnpm --filter @workspace/appforge build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://maris-ai-api-server-6c5u.onrender.com/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
