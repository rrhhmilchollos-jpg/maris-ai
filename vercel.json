{
  "outputDirectory": "artifacts/appforge/dist",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/appforge build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://maris-ai-api-server.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
