{
  "outputDirectory": "artifacts/appforge/dist",
  "buildCommand": "pnpm --filter @workspace/appforge build",
  "installCommand": "npm install -g pnpm@10.11.0 && pnpm install",
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/news-sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://maris-ai-api-server-6c5u.onrender.com/api/:path*"
    },
    {
      "source": "/news-sitemap.xml",
      "destination": "https://maris-ai-api-server-6c5u.onrender.com/news-sitemap.xml"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://maris-ai-api-server-6c5u.onrender.com/sitemap.xml"
    },
    {
      "source": "/rss",
      "destination": "https://maris-ai-api-server-6c5u.onrender.com/rss"
    },
    {
      "source": "/rss/:path*",
      "destination": "https://maris-ai-api-server-6c5u.onrender.com/rss/:path*"
    },
    {
      "source": "/news/:slug",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(googlebot|bingbot|slurp|duckduckbot|baiduspider|yandexbot|twitterbot|linkedinbot|facebot|developers\\.google\\.com).*" }],
      "destination": "https://maris-ai-api-server-6c5u.onrender.com/bot-render/news/:slug"
    },
    {
      "source": "/news",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(googlebot|bingbot|slurp|duckduckbot|baiduspider|yandexbot|twitterbot|linkedinbot|facebot|developers\\.google\\.com).*" }],
      "destination": "https://maris-ai-api-server-6c5u.onrender.com/bot-render/news"
    },
    {
      "source": "/vs-emergent",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(googlebot|bingbot|slurp|duckduckbot|baiduspider|yandexbot|twitterbot|linkedinbot|facebot|developers\\.google\\.com).*" }],
      "destination": "https://maris-ai-api-server-6c5u.onrender.com/bot-render/vs-emergent"
    },
    {
      "source": "/pricing",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(googlebot|bingbot|slurp|duckduckbot|baiduspider|yandexbot|twitterbot|linkedinbot|facebot|developers\\.google\\.com).*" }],
      "destination": "https://maris-ai-api-server-6c5u.onrender.com/bot-render/pricing"
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(googlebot|bingbot|slurp|duckduckbot|baiduspider|yandexbot|twitterbot|linkedinbot|facebot|developers\\.google\\.com).*" }],
      "destination": "https://maris-ai-api-server-6c5u.onrender.com/bot-render/"
    },
    {
      "source": "/((?!robots\\.txt$|favicon\\.svg$|logo\\.svg$|logo-dark\\.svg$|hero-illustration\\.svg$|opengraph\\.jpg$|assets/).*)",
      "destination": "/index.html"
    }
  ]
}

