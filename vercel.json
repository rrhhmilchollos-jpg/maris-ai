{
  "version": 2,
  "framework": "vite",
  "outputDirectory": "artifacts/appforge/dist",
  "buildCommand": "pnpm --filter @workspace/appforge build",
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://maris-ai-api-server-6c5u.onrender.com/api/:path*" },
    { "source": "/news-sitemap.xml", "destination": "https://maris-ai-api-server-6c5u.onrender.com/news-sitemap.xml" },
    { "source": "/sitemap.xml", "destination": "https://maris-ai-api-server-6c5u.onrender.com/sitemap.xml" },
    { "source": "/rss", "destination": "https://maris-ai-api-server-6c5u.onrender.com/rss" },
    { "source": "/rss/:path*", "destination": "https://maris-ai-api-server-6c5u.onrender.com/rss/:path*" },
    {
      "source": "/news/:slug*",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(googlebot|bingbot|slurp|duckduckbot|baiduspider|yandexbot|sogou|ia_archiver|twitterbot|linkedinbot|applebot|google-inspectiontool|googleother|google-extended|google-news|googlebot-news|feedfetcher-google).*" }],
      "destination": "https://maris-ai-api-server-6c5u.onrender.com/bot-render/news/:slug*"
    },
    {
      "source": "/news",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(googlebot|bingbot|slurp|duckduckbot|baiduspider|yandexbot|sogou|ia_archiver|twitterbot|linkedinbot|applebot|google-inspectiontool|googleother|google-extended|google-news|googlebot-news|feedfetcher-google).*" }],
      "destination": "https://maris-ai-api-server-6c5u.onrender.com/bot-render/news"
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(googlebot|bingbot|slurp|duckduckbot|baiduspider|yandexbot|sogou|ia_archiver|twitterbot|linkedinbot|applebot|google-inspectiontool|googleother|google-extended|google-news|googlebot-news|feedfetcher-google).*" }],
      "destination": "https://maris-ai-api-server-6c5u.onrender.com/bot-render/"
    },
    {
      "source": "/pricing",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(googlebot|bingbot|slurp|duckduckbot|baiduspider|yandexbot|sogou|ia_archiver|twitterbot|linkedinbot|applebot|google-inspectiontool|googleother|google-extended|google-news|googlebot-news|feedfetcher-google).*" }],
      "destination": "https://maris-ai-api-server-6c5u.onrender.com/bot-render/pricing"
    },
    {
      "source": "/vs-emergent",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(googlebot|bingbot|slurp|duckduckbot|baiduspider|yandexbot|sogou|ia_archiver|twitterbot|linkedinbot|applebot|google-inspectiontool|googleother|google-extended|google-news|googlebot-news|feedfetcher-google).*" }],
      "destination": "https://maris-ai-api-server-6c5u.onrender.com/bot-render/vs-emergent"
    },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "marisai.es" }], "destination": "https://www.marisai.es/:path*", "permanent": true }
  ]
}
