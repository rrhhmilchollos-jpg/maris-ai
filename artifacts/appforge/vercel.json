{
  "version": 2,
  "framework": "vite",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.clerk.accounts.dev https://*.clerk.com https://clerk.marisai.es https://cdn.jsdelivr.net https://js.stripe.com https://cdn.tailwindcss.com https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com https:; img-src 'self' data: blob: https:; connect-src 'self' https://*.clerk.accounts.dev https://*.clerk.com https://clerk.marisai.es https://api.marisai.es https://maris-ai-api-server-6c5u.onrender.com https://*.stripe.com wss: https://accounts.google.com; frame-src 'self' https://*.clerk.accounts.dev https://*.clerk.com https://clerk.marisai.es https://js.stripe.com https://hooks.stripe.com https://accounts.google.com; worker-src 'self' blob:; object-src 'none';" }
      ]
    },
    {
      "source": "/sign-in(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/sign-up(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/app(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/dashboard(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/((?!sign-in|sign-up).*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://maris-ai-api-server.onrender.com/api/:path*" },
    { "source": "/news-sitemap.xml", "destination": "https://maris-ai-api-server.onrender.com/news-sitemap.xml" },
    { "source": "/sitemap.xml", "destination": "https://maris-ai-api-server.onrender.com/sitemap.xml" },
    { "source": "/rss", "destination": "https://maris-ai-api-server.onrender.com/rss" },
    { "source": "/rss/:path*", "destination": "https://maris-ai-api-server.onrender.com/rss/:path*" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "marisai.es" }], "destination": "https://www.marisai.es/:path*", "permanent": true }
  ]
}
