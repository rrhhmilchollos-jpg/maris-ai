{
  "framework": "vite",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/sitemap.xml",
      "dest": "https://maris-ai-api-server-6c5u.onrender.com/sitemap.xml"
    },
    {
      "src": "/news-sitemap.xml",
      "dest": "https://maris-ai-api-server-6c5u.onrender.com/news-sitemap.xml"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://maris-ai-api-server-6c5u.onrender.com/api/$1"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|bingbot|Baiduspider|yandex|Twitterbot|facebookexternalhit|LinkedInBot|Embedly|quora.*link.*preview|showyoubot|outbrain|pinterest\\/0\\.|slackbot|vkShare|W3C_Validator|WhatsApp|TelegramBot).*"
        }
      ],
      "dest": "https://maris-ai-api-server-6c5u.onrender.com/bot-render/"
    },
    {
      "src": "/pricing",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|bingbot|Baiduspider|yandex|Twitterbot|facebookexternalhit|LinkedInBot|Embedly|quora.*link.*preview|showyoubot|outbrain|pinterest\\/0\\.|slackbot|vkShare|W3C_Validator|WhatsApp|TelegramBot).*"
        }
      ],
      "dest": "https://maris-ai-api-server-6c5u.onrender.com/bot-render/pricing"
    },
    {
      "src": "/vs-emergent",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|bingbot|Baiduspider|yandex|Twitterbot|facebookexternalhit|LinkedInBot|Embedly|quora.*link.*preview|showyoubot|outbrain|pinterest\\/0\\.|slackbot|vkShare|W3C_Validator|WhatsApp|TelegramBot).*"
        }
      ],
      "dest": "https://maris-ai-api-server-6c5u.onrender.com/bot-render/vs-emergent"
    },
    {
      "src": "/news",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|bingbot|Baiduspider|yandex|Twitterbot|facebookexternalhit|LinkedInBot|Embedly|quora.*link.*preview|showyoubot|outbrain|pinterest\\/0\\.|slackbot|vkShare|W3C_Validator|WhatsApp|TelegramBot).*"
        }
      ],
      "dest": "https://maris-ai-api-server-6c5u.onrender.com/bot-render/news"
    },
    {
      "src": "/news/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|bingbot|Baiduspider|yandex|Twitterbot|facebookexternalhit|LinkedInBot|Embedly|quora.*link.*preview|showyoubot|outbrain|pinterest\\/0\\.|slackbot|vkShare|W3C_Validator|WhatsApp|TelegramBot).*"
        }
      ],
      "dest": "https://maris-ai-api-server-6c5u.onrender.com/bot-render/news/$1"
    },
    {
      "src": "/(.+\\.(js|css|svg|png|jpg|ico|woff2|woff|ttf|eot|map))",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "X-XSS-Protection": "1; mode=block",
        "Cross-Origin-Opener-Policy": "same-origin-allow-popups",
        "Cross-Origin-Embedder-Policy": "credentialless"
      },
      "dest": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "marisai.es" }],
      "destination": "https://www.marisai.es/:path*",
      "permanent": true
    }
  ]
}
