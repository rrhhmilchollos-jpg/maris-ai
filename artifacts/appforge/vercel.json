{
  "version": 2,
  "framework": "vite",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" },
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" },
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
        { "key": "Content-Security-Policy", "value": "default-src 'self' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; font-src 'self' data: https:; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-src 'self' https:; worker-src 'self' blob:; object-src 'none';" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://maris-ai-api-server.onrender.com/api/:path*" },
    { "source": "/news-sitemap.xml", "destination": "https://maris-ai-api-server.onrender.com/news-sitemap.xml" },
    { "source": "/sitemap.xml", "destination": "https://maris-ai-api-server.onrender.com/sitemap.xml" },
    { "source": "/rss", "destination": "https://maris-ai-api-server.onrender.com/rss" },
    { "source": "/rss/:path*", "destination": "https://maris-ai-api-server.onrender.com/rss/:path*" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "marisai.es" }], "destination": "https://www.marisai.es/:path*", "permanent": true }
  ]
}
