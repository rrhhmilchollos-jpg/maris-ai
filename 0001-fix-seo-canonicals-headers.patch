+    intro: "Crea tu cuenta gratuita en Maris AI y genera tu primera app con IA en minutos. 50 créditos de bienvenida incluidos.",
+    noindex: true,
+  },
+  {
+    path: "/glosario",
+    title: "Glosario de IA para Emprendedores | Maris AI",
+    description:
