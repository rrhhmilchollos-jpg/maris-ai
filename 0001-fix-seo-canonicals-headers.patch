+// scripts/prerender-seo.mjs
+//
+// Por qué existe este script
+// ---------------------------
+// Maris AI es una SPA (React + Vite, sin SSR). El index.html que se sirve
+// es el MISMO fichero para todas las rutas: el <title>, la meta description
+// y el <link rel="canonical"> reales se escriben con JavaScript en tiempo
+// de ejecución (ver el <script> inline de routeMeta en index.html y
+// src/components/pillar-layout.tsx).
+//
+// Cualquier crawler que NO ejecute JavaScript (Screaming Frog en modo texto,
+// el bot de auditoría de SEMrush, etc.) ve siempre el HTML "de fábrica":
+// el title/description/canonical de la home en TODAS las URLs. Esto es
+// exactamente lo que provoca:
+//   - "Canonicals" apuntando a otra URL en el 86% de las páginas
+//   - H1 ausente (la home no tiene <h1> en el HTML estático)
+//   - Title/description duplicados o demasiado largos en bloque
+//
+// Este script se ejecuta DESPUÉS de `vite build` (hook "postbuild" en
+// package.json) y genera, para cada ruta conocida, una copia de
+// dist/index.html con su <title>, meta description, canonical, og:*,
+// twitter:* y un <h1> real ya "horneados" en el HTML, sin tocar el bundle
+// JS ni el comportamiento de la SPA para el usuario (React sigue montando
+// igual en #root y el script de routeMeta sigue actualizando el <head> en
+// cliente, así que el resultado visual no cambia).
+//
+// Vercel sirve un fichero estático que coincide con la ruta ANTES de
+// aplicar el rewrite catch-all a /index.html, así que basta con escribir
+// dist/<ruta>/index.html para que cada URL tenga su propio HTML.
+
+import { readFileSync, writeFileSync, mkdirSync, existsSync } from "node:fs";
+import { join, dirname } from "node:path";
+import { fileURLToPath } from "node:url";
+
+const __dirname = dirname(fileURLToPath(import.meta.url));
+const DIST_DIR = join(__dirname, "..", "dist");
+const TEMPLATE_PATH = join(DIST_DIR, "index.html");
+const SITE = "https://www.marisai.es";
+
+if (!existsSync(TEMPLATE_PATH)) {
+  console.error(`[prerender-seo] No existe ${TEMPLATE_PATH}. ¿Se ha ejecutado "vite build" antes?`);
+  process.exit(1);
+}
+
+const template = readFileSync(TEMPLATE_PATH, "utf-8");
+
+// Título/descripción acortados para cumplir <=60 caracteres (title) y
+// <=160 caracteres (meta description) — límites de truncado en Google.
+const ROUTES = [
+  {
+    path: "/",
+    title: "Maris AI | Crea Apps con Inteligencia Artificial",
+    description:
+      "Convierte tu idea en una app real en minutos. 9 agentes de IA generan código profesional listo para producción. Alternativa en español a Bolt y Emergent.",
+    h1: "Tu visión. Apps reales en minutos.",
+    intro:
+      "Transforma tus ideas más ambiciosas en aplicaciones funcionales y listas para el mercado, impulsadas por un equipo de 9 agentes IA de élite.",
+  },
+  {
+    path: "/pricing",
+    title: "Créditos y Precios — Maris AI | 50 Créditos Gratis",
+    description:
+      "Compra créditos para generar apps con IA desde 20€ por 160 créditos que nunca caducan. Empieza gratis con 50 créditos de bienvenida, sin tarjeta.",
+    h1: "Créditos flexibles para tu éxito.",
+    intro:
+      "Paga solo lo que necesitas. Los créditos nunca caducan y se usan para generar apps con los 9 agentes IA de Maris AI.",
+  },
+  {
+    path: "/news",
+    title: "Blog de IA para Emprendedores — Maris AI",
+    description:
+      "Artículos, guías y noticias sobre inteligencia artificial para emprendedores en España. Cómo crear apps con IA, vibe coding, no-code y novedades de Maris AI.",
+    h1: "Noticias de Maris AI",
+    intro:
+      "Artículos, guías y noticias sobre inteligencia artificial para emprendedores en España: cómo crear apps con IA, vibe coding y no-code.",
+  },
+  {
+    path: "/vs-emergent",
+    title: "Maris AI vs Emergent.sh — Comparativa 2026",
+    description:
+      "Compara Maris AI con Emergent.sh: precio, velocidad, calidad del código, agentes especializados y soporte. Descubre por qué Maris AI es la mejor alternativa.",
+    h1: "Maris AI vs Emergent.sh: Comparativa completa 2026",
+    intro: "Alternativa en español a Emergent.sh, Bolt.new y Lovable.",
+  },
+  {
+    path: "/legal/privacidad",
+    title: "Política de Privacidad — Maris AI",
+    description: "Política de privacidad de Maris AI. Cómo recopilamos, usamos y protegemos tus datos personales conforme al RGPD.",
+    h1: "Política de Privacidad",
+    intro: "Información sobre cómo Maris AI recopila, usa y protege tus datos personales conforme al RGPD.",
+  },
+  {
+    path: "/legal/aviso-legal",
+    title: "Aviso Legal — Maris AI",
+    description: "Aviso legal e información sobre el responsable del sitio web marisai.es conforme a la LSSI.",
+    h1: "Aviso Legal",
+    intro: "Información sobre el responsable del sitio web marisai.es conforme a la LSSI.",
+  },
+  {
+    path: "/legal/cookies",
+    title: "Política de Cookies — Maris AI",
+    description: "Información sobre las cookies utilizadas en marisai.es y cómo gestionarlas.",
+    h1: "Política de Cookies",
