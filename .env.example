# =============================================================================
# MARIS AI — Variables de Entorno de Producción
# =============================================================================
# Copia este archivo como .env (nunca subas .env al repositorio).
# Configura TODAS estas variables en Coolify (api-server y worker) y en el frontend.
# =============================================================================

# -----------------------------------------------------------------------------
# SERVIDOR
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# URL pública del frontend (Coolify)
APP_URL=https://marisai.es
FRONTEND_URL=https://marisai.es
MARIS_AI_PUBLIC_URL=https://marisai.es
MARIS_AI_DOMAIN=marisai.es

# URL pública del API (Coolify)
API_URL=https://api.marisai.es

# URLs públicas base para el frontend (Next.js / Coolify)
NEXT_PUBLIC_APP_URL=https://marisai.es
NEXT_PUBLIC_SITE_URL=https://marisai.es
NEXT_PUBLIC_API_URL=https://marisai.es
NEXT_PUBLIC_BACKEND_URL=https://marisai.es

# -----------------------------------------------------------------------------
# BASE DE DATOS — MongoDB (Coolify)
# -----------------------------------------------------------------------------
# Coolify la genera automáticamente al crear el servicio MongoDB
MONGODB_URI=mongodb://user:password@host:port/maris-ai?authSource=admin

# -----------------------------------------------------------------------------
# AUTENTICACIÓN — Clerk
# -----------------------------------------------------------------------------
# Obtener en: https://dashboard.clerk.com → API Keys
CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsubWFyaXNhaS5lcyQ
CLERK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
# Variables con prefijo Next.js para el middleware de autenticación de Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsubWFyaXNhaS5lcyQ
# Obtener en: Clerk Dashboard → Webhooks → Signing Secret
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# IA — CLAUDE (ANTHROPIC) — MOTOR PRINCIPAL
# -----------------------------------------------------------------------------
# Todo el pipeline multi-agente (Researcher, Architect, Designer, Frontend,
# Backend, QA, Patcher, Repair, chat...) funciona con los modelos Claude de
# Anthropic a través de su API oficial (https://api.anthropic.com).
# Obtener la API key en: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Alias aceptado por compatibilidad con los SDKs conectados:
AI_INTEGRATIONS_ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Mapa de modelos (opcional — estos son los valores por defecto).
# Los alias internos del código se traducen automáticamente:
#   zoco-flash → ANTHROPIC_MODEL_FAST      (tareas rápidas/baratas)
#   zoco-plus  → ANTHROPIC_MODEL_STANDARD  (equilibrio calidad/coste)
#   zoco-max   → ANTHROPIC_MODEL_MAX       (máxima capacidad)
# ANTHROPIC_MODEL_FAST=claude-haiku-4-5
# ANTHROPIC_MODEL_STANDARD=claude-sonnet-4-5
# ANTHROPIC_MODEL_MAX=claude-opus-4-5
#
# EMBEDDINGS — Voyage AI (proveedor recomendado por Anthropic; Claude no
# ofrece endpoint de embeddings). OPCIONAL: si no se configura, la memoria
# de agentes y la caché de componentes usan hashing léxico local (sin red).
# Obtener en: https://dash.voyageai.com → API Keys
# VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VOYAGE_EMBED_MODEL=voyage-3.5-lite
#
# Opcional — gateway multimodal (imágenes/vídeo). Si no está configurado,
# las funciones visuales quedan desactivadas con un error claro.
# ZOCOIA_GEMINI_GATEWAY_URL=https://zocoia.es

# LEGADO — Estas variables ya NO se usan (migración Ollama → Claude completada).
# Elimínalas de Coolify si siguen definidas:
#   ZOCOIA_API_URL, ZOCOIA_API_KEY,
#   OLLAMA_BASE_URL, OLLAMA_URL, OLLAMA_API_KEY, OLLAMA_MODEL_PLUS,
#   OLLAMA_EMBED_MODEL, GROQ_API_KEY

# -----------------------------------------------------------------------------
# VALIDACIÓN E2B — Build real en microVM
# -----------------------------------------------------------------------------
# Obtener en: https://e2b.dev/dashboard → API Keys
E2B_API_KEY=e2b_xxxxxxxxxxxxxxxxxxxx
# Activar la validación E2B en el pipeline de generación
E2B_VALIDATE_ON_GENERATE=true

# -----------------------------------------------------------------------------
# PAGOS — Stripe
# -----------------------------------------------------------------------------
# Obtener en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_API_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
# Obtener en: Stripe Dashboard → Webhooks → Signing Secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
# IDs de precios de Stripe (crear en Stripe Dashboard → Products)
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PACK_10=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PACK_50=price_xxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# EMAIL — Resend (notificaciones y soporte)
# -----------------------------------------------------------------------------
# Obtener en: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=no-reply@marisai.es
RESEND_TO_EMAIL=soporte@marisai.es
SUPPORT_EMAIL=soporte@marisai.es

# -----------------------------------------------------------------------------
# DEPLOY AUTOMÁTICO — Vercel (para publicar las apps generadas)
# -----------------------------------------------------------------------------
# Obtener en: https://vercel.com/account/tokens
VERCEL_API_TOKEN=xxxxxxxxxxxxxxxxxxxx
VERCEL_TOKEN=xxxxxxxxxxxxxxxxxxxx
# Obtener en: Vercel Dashboard → Settings → Team ID
VERCEL_TEAM_ID=team_xxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# GITHUB — Exportación de código de usuarios
# -----------------------------------------------------------------------------
# Obtener en: https://github.com/settings/tokens (necesita permisos repo)
MARIS_AI_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# OAuth App para que usuarios conecten su GitHub
GITHUB_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# BÚSQUEDA WEB — Para el Researcher Agent
# -----------------------------------------------------------------------------
# Obtener en: https://serper.dev
SERPER_API_KEY=xxxxxxxxxxxxxxxxxxxx
# Obtener en: https://api.search.brave.com
BRAVE_API_KEY=xxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# ALMACENAMIENTO — AWS S3 (para imágenes generadas y assets)
# -----------------------------------------------------------------------------
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxx
AWS_S3_BUCKET=maris-ai-assets

# -----------------------------------------------------------------------------
# IMÁGENES — Cloudinary (alternativa a S3 para imágenes)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=xxxxxxxxxxxxxxxxxxxx
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# MONITOREO — Sentry (errores en producción)
# -----------------------------------------------------------------------------
# Obtener en: https://sentry.io → Settings → Projects → DSN
SENTRY_DSN_API=https://xxxx@sentry.io/xxxx

# -----------------------------------------------------------------------------
# COLA DE TRABAJOS — BullMQ con Redis
# -----------------------------------------------------------------------------
# Coolify genera la URL automáticamente al añadir el servicio Redis
REDIS_URL=redis://default:password@host:port
JOB_CONCURRENCY=10
JOB_POLL_INTERVAL_MS=2000

# -----------------------------------------------------------------------------
# NOTIFICACIONES PUSH — OneSignal (notificaciones web)
# -----------------------------------------------------------------------------
ONESIGNAL_APP_ID=xxxxxxxxxxxxxxxxxxxx
ONESIGNAL_API_KEY=xxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# ADMINISTRACIÓN
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@marisai.es
ADMIN_EMAILS=admin@marisai.es,soporte@marisai.es
ADMIN_ALERT_EMAILS=admin@marisai.es

# Límites de rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# FRONTEND — Coolify (variables VITE_ solo para el frontend)
# -----------------------------------------------------------------------------
# Configurar en: Coolify → Application → Environment Variables
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsubWFyaXNhaS5lcyQ
VITE_API_URL=https://api.marisai.es
VITE_SENTRY_DSN_WEB=https://xxxx@sentry.io/xxxx
