# Copia este archivo a ".env" (sin ".example") en esta misma carpeta antes
# de levantar Authentik. NUNCA subas el ".env" real a GitHub — ya está
# excluido en .gitignore (ver más abajo en el README).

# Contraseña de la base de datos Postgres de Authentik.
# Genera una segura, por ejemplo con: openssl rand -base64 36
PG_PASS=

# Usuario y nombre de base de datos — puedes dejar estos por defecto
PG_USER=authentik
PG_DB=authentik

# Clave secreta interna de Authentik (firma cookies de sesión, tokens, etc.)
# Genera una con: openssl rand -base64 60
AUTHENTIK_SECRET_KEY=
