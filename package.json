{
  "name": "workspace",
  "version": "0.0.3",
  "license": "MIT",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "vercel": {
    "outputDirectory": "artifacts/appforge/dist",
    "buildCommand": "pnpm --filter @workspace/appforge build",
    "framework": "vite"
  },
  "devDependencies": {
    "execa": "^9.6.1",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
